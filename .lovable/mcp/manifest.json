{
  "version": 1,
  "sdk_version": "3.1.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "monte-listing-pro",
      "version": "0.1.0",
      "title": "Monte Listing Pro"
    },
    "tools": [
      {
        "name": "list_properties",
        "title": "Listar imóveis",
        "description": "Lista os imóveis publicados da Marangoni, com filtros opcionais de finalidade, tipo e palavra-chave.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "purpose": {
              "description": "Finalidade.",
              "type": "string",
              "enum": [
                "venda",
                "aluguel"
              ]
            },
            "type": {
              "description": "Tipo do imóvel.",
              "type": "string",
              "enum": [
                "casa",
                "apartamento",
                "terreno",
                "comercial",
                "rural"
              ]
            },
            "search": {
              "description": "Bairro ou palavra-chave.",
              "type": "string",
              "maxLength": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_property",
        "title": "Detalhes do imóvel",
        "description": "Retorna os detalhes de um imóvel publicado pela referência de 8 caracteres e o link de WhatsApp para consulta.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 4,
              "maxLength": 40,
              "description": "Referência do imóvel exibida no site."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_contact",
        "title": "Contato da Marangoni",
        "description": "Retorna o WhatsApp oficial e a cidade de atendimento da Marangoni Despachante Imobiliário.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
